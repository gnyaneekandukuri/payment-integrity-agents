        <mxCell id="sam-30" value="• Contract repository&lt;br&gt;• Policy team" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#F4F6F9;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="598" y="333" width="210" height="95" as="geometry" />
