        <mxCell id="sam-38" value="• Hospital appeals team&lt;br&gt;• Physician advisor" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#F4F6F9;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="2326" y="333" width="210" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sam-39" value="&lt;b&gt;Evidence available&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#DDE3EC;strokeColor=#B0B7C3;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="434" width="140" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sam-40" value="Claim: billed DRG, codes, dates" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="166" y="434" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sam-41" value="Diagnosis codes, present-on-admission flags" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="382" y="434" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sam-42" value="• Assumed: Sepsis-3 (infection + acute SOFA change ≥ 2)&lt;br&gt;• Contract may be silent (open question)" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="598" y="434" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sam-43" value="Completeness: vitals, labs, notes, medication record, baseline history" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="814" y="434" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sam-44" value="Hundreds of pages, out of order, duplicates" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="1030" y="434" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sam-45" value="• Values with dates and page numbers&lt;br&gt;• Gaps: &#39;not documented&#39; stays not documented" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="1246" y="434" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sam-46" value="• Ortiz: demonstrated&lt;br&gt;• Lee: not demonstrated (complete record)&lt;br&gt;• Patel: cannot determine (uncertain baseline, conflicting notes)" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="1462" y="434" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sam-47" value="Sam&#39;s evidence summary and open questions" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="1678" y="434" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sam-48" value="• Validated codes → resulting DRG&lt;br&gt;• Payment difference known only now" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="1894" y="434" width="210" height="120" as="geometry" />
