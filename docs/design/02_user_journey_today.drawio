        <mxCell id="maya-60" value="Days" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFF6D6;strokeColor=#D6B656;" vertex="1" parent="1">
