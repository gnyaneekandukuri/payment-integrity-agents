        <mxCell id="maya-47" value="Per-stay findings arrive as reviews finish" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="1678" y="434" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="maya-48" value="• 4 criteria demonstrated&lt;br&gt;• 10 not demonstrated (regrouped by coder)&lt;br&gt;• 5 cannot determine&lt;br&gt;• 1 record missing&lt;br&gt;• Describes these stays only" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
