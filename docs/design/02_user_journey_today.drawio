        </mxCell>
        <mxCell id="maya-62" value="Months" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFF6D6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="2326" y="560" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="maya-63" value="&lt;b&gt;Pain points&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#DDE3EC;strokeColor=#B0B7C3;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="621" width="140" height="130" as="geometry" />
        </mxCell>
        <mxCell id="maya-64" value="Many hospitals listed; little context on why each differs" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="166" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="maya-65" value="• Depends on data team for queries&lt;br&gt;• Errors found late waste later work" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="382" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="maya-66" value="Peer choice is a judgment call and easy to challenge" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="598" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="maya-67" value="• Each check is a new request&lt;br&gt;• Claims can&#39;t answer the clinical questions" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="814" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="maya-68" value="Easy for a rough range to be misquoted as &#39;the overpayment&#39;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="1030" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="maya-69" value="• Approval loop&lt;br&gt;• Contract limits on record requests (open question)" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="1246" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="maya-70" value="Long wait; partial returns" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="1462" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="maya-71" value="• Competes with everyday reviews&lt;br&gt;• Little visibility into progress" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="1678" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="maya-72" value="Pressure to turn a targeted sample into a hospital-wide rate" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="1894" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="maya-73" value="• Many sign-offs&lt;br&gt;• Relationship risk with the hospital" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="2110" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="maya-74" value="Outcomes arrive long after the work" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="2326" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="maya-75" value="&lt;b&gt;Thinking&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#DDE3EC;strokeColor=#B0B7C3;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="757" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="maya-76" value="“Different isn&#39;t wrong. Is this worth a look?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="166" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="maya-77" value="“Am I looking at a real pattern or a data glitch?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="382" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="maya-78" value="“Is this a fair comparison?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="598" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="maya-79" value="“What&#39;s still unexplained, and can data answer it?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="814" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="maya-80" value="“Is a records review worth the cost and provider burden?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1030" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="maya-81" value="“Only records can answer what&#39;s left.”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1246" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="maya-82" value="“Another month before I learn anything.”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1462" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="maya-83" value="“My question is in someone else&#39;s backlog.”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1678" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="maya-84" value="“What do these findings actually let us say?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1894" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="maya-85" value="“Which step is justified by what we actually know?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="2110" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="maya-86" value="“Did the findings hold up?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="2326" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="maya-87" value="&lt;b&gt;Summary:&lt;/b&gt; Most of Maya&#39;s time goes into requesting, waiting and assembling evidence, not judging it. Moments that matter: a fair comparison (3), honest status of each explanation (4), not over-reading a targeted sample (9), recommending only what the evidence supports (10)." style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E8F3EA;strokeColor=#6AA57A;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="853" width="2522" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
