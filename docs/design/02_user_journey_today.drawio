        <mxCell id="maya-49" value="• Review findings&lt;br&gt;• Contract terms&lt;br&gt;• Sensitivity range (labelled)" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
