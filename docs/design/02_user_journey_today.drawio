        <mxCell id="sam-52" value="Ongoing; long queue" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFF6D6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="166" y="560" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sam-53" value="10–15 min" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFF6D6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="382" y="560" width="210" height="55" as="geometry" />
