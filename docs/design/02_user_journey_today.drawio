  <diagram id="maya" name="2 · Maya – current journey">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="maya-1" value="&lt;b&gt;Maya Chen, payment integrity analyst · Current journey: reviewing a hospital&#39;s billing pattern&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="2522" height="34" as="geometry" />
        </mxCell>
        <mxCell id="maya-2" value="Question: fictional Riverside General bills 38% of infection-related stays as MS-DRG 871 vs a peer median of 18% (Northstar MA members). A pattern raises a question; it is not evidence of error or fraud." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="20" y="56" width="2522" height="26" as="geometry" />
        </mxCell>
        <mxCell id="maya-3" value="&lt;b&gt;Stage&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#1F3A5F;fontColor=#FFFFFF;strokeColor=#1F3A5F;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="96" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maya-4" value="&lt;b&gt;1. A question arrives&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="166" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maya-5" value="&lt;b&gt;2. Check data quality&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="382" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maya-6" value="&lt;b&gt;3. Build the peer comparison&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="598" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maya-7" value="&lt;b&gt;4. Test explanations&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="814" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maya-8" value="&lt;b&gt;5. Size the scale (hypothetically)&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1030" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maya-9" value="&lt;b&gt;6. Recommend a targeted review&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1246" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maya-10" value="&lt;b&gt;7. Request records&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1462" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maya-11" value="&lt;b&gt;8. Clinical and coding review&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1678" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maya-12" value="&lt;b&gt;9. Interpret review findings&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1894" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maya-13" value="&lt;b&gt;10. Recommend next step&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2110" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maya-14" value="&lt;b&gt;11. Follow-through&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2326" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maya-15" value="&lt;b&gt;What they do&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#DDE3EC;strokeColor=#B0B7C3;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="152" width="140" height="175" as="geometry" />
        </mxCell>
        <mxCell id="maya-16" value="• Reads the quarterly monitoring report&lt;br&gt;• Sees Riverside&#39;s DRG 871 share is high and rising (22% → 38% in two years)" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="166" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="maya-17" value="• Checks for duplicates, feed or mapping errors&lt;br&gt;• Reconciles claims to paid amounts" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="382" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="maya-18" value="• Chooses comparable hospitals (region, size, teaching status)&lt;br&gt;• Re-runs with an alternative peer group (referral hospitals)" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="598" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="maya-19" value="• Records each explanation as supported / weakened / unresolved&lt;br&gt;• Severity, transfers in, ICU use, length of stay, documentation change, sepsis definition" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="814" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="maya-20" value="Builds a sensitivity table with explicit assumptions to judge whether review is proportionate" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="1030" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="maya-21" value="• Recommends records for 20 stays chosen to test the open questions (short stay, no ICU, not transferred)&lt;br&gt;• Manager approves; provider relations informed" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="1246" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="maya-22" value="• Sends request to Riverside&lt;br&gt;• Tracks receipts; chases missing" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="1462" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="maya-23" value="• Hands records to Sam (clinical reviewer), Lena (coder), Dr. Adeyemi (escalations)&lt;br&gt;• Waits" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="1678" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="maya-24" value="Summarizes per-stay results without extrapolating" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="1894" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="maya-25" value="Writes options for approvers: no action, more evidence, adjust reviewed claims, education, statistical sample, prepayment review, SIU only if fraud indicators" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="2110" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="maya-26" value="• Most likely: request evidence for the 5 unresolved stays and Riverside&#39;s sepsis documentation policy&lt;br&gt;• Track appeals on any adjusted claims&lt;br&gt;• Keep monitoring" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="2326" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="maya-27" value="&lt;b&gt;Who / where&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#DDE3EC;strokeColor=#B0B7C3;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="333" width="140" height="95" as="geometry" />
        </mxCell>
        <mxCell id="maya-28" value="• Monitoring report&lt;br&gt;• Work queue" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#F4F6F9;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="166" y="333" width="210" height="95" as="geometry" />
        </mxCell>
        <mxCell id="maya-29" value="• Claims warehouse&lt;br&gt;• Data / IT team" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#F4F6F9;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="382" y="333" width="210" height="95" as="geometry" />
        </mxCell>
