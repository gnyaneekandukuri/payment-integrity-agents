          <mxGeometry x="382" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sam-6" value="&lt;b&gt;3. Check the criteria&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="598" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sam-7" value="&lt;b&gt;4. Get a usable record&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="814" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sam-8" value="&lt;b&gt;5. Orient in the chart&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1030" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sam-9" value="&lt;b&gt;6. Gather evidence by criterion&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1246" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sam-10" value="&lt;b&gt;7. Judge the clinical question&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1462" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sam-11" value="&lt;b&gt;8. Escalate if needed&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1678" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sam-12" value="&lt;b&gt;9. Coding and regrouping&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1894" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sam-13" value="&lt;b&gt;10. Document and approve&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2110" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sam-14" value="&lt;b&gt;11. Appeal and re-review&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#2E5C8A;fontColor=#FFFFFF;strokeColor=#2E5C8A;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="2326" y="96" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sam-15" value="&lt;b&gt;What they do&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#DDE3EC;strokeColor=#B0B7C3;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="152" width="140" height="175" as="geometry" />
        </mxCell>
        <mxCell id="sam-16" value="• Picks the next claim from the queue&lt;br&gt;• Source: Maya&#39;s targeted request OR routine selection (pre-pay rule, post-pay audit, QA sample, appeal re-review)" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="166" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="sam-17" value="Identifies principal diagnosis (sepsis) and the secondary diagnosis acting as the MCC" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="382" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="sam-18" value="Looks up which clinical criteria apply under this hospital&#39;s contract" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="598" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="sam-19" value="Confirms the record is complete enough; requests missing parts" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="814" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="sam-20" value="• Opens a long, often scanned PDF&lt;br&gt;• Finds notes, vitals, labs, medications" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="1030" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="sam-21" value="• Infection evidence&lt;br&gt;• Baseline organ function&lt;br&gt;• Each SOFA system over time&lt;br&gt;• Lactate, vasopressors, fluids, timing&lt;br&gt;• Notes supporting AND contradicting evidence" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="1246" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="sam-22" value="• Concludes: criteria demonstrated / not demonstrated / cannot determine&lt;br&gt;• Lists what is missing or conflicting" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="1462" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="sam-23" value="Sends unclear or conflicting cases to Dr. Adeyemi (physician advisor)" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="1678" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="sam-24" value="Lena validates ALL diagnoses (including the MCC) and regroups under MS-DRG v43" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="1894" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="sam-25" value="• Writes rationale with page citations&lt;br&gt;• Manager approves any adjustment&lt;br&gt;• Findings letter with appeal rights" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="2110" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="sam-26" value="• Hospital may appeal&lt;br&gt;• Sam or Dr. Adeyemi re-reviews; peer-to-peer possible" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="2326" y="152" width="210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="sam-27" value="&lt;b&gt;Who / where&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#DDE3EC;strokeColor=#B0B7C3;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="333" width="140" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sam-28" value="Review work queue" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#F4F6F9;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="166" y="333" width="210" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sam-29" value="• Claims system&lt;br&gt;• Grouper output" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#F4F6F9;strokeColor=#B0B7C3;" vertex="1" parent="1">
          <mxGeometry x="382" y="333" width="210" height="95" as="geometry" />
