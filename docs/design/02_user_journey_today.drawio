          <mxGeometry height="40" width="250" x="1530" y="486" as="geometry" />
        </mxCell>
        <mxCell id="ov-23" edge="1" parent="1" source="ov-7" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2E5C8A;fontSize=12;" target="ov-22" value="">
