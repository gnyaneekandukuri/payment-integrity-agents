        <mxCell id="ov-28" parent="1" style="whiteSpace=wrap;html=1;rounded=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=6;fillColor=#FFFFFF;strokeColor=#9A86C2;verticalAlign=middle;" value="SIU referral only if fraud indicators appear" vertex="1">
          <mxGeometry height="40" width="250" x="1290" y="640" as="geometry" />
        </mxCell>
        <mxCell id="ov-29" edge="1" parent="1" source="ov-7" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2E5C8A;fontSize=12;" target="ov-28" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov-30" parent="1" style="whiteSpace=wrap;html=1;rounded=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=6;fillColor=#FDE4E1;strokeColor=#D9776C;verticalAlign=middle;fontSize=13;" value="&lt;b&gt;Key rules:&lt;/b&gt; a pattern is a question, not a finding  •  &#39;ruled out&#39; only when evidence shows it  •  targeted samples describe only the stays reviewed  •  clinical review is separate from DRG assignment  •  missing evidence stays missing  •  a human reviews every case  •  unusual billing or disputed diagnoses are not fraud evidence" vertex="1">
