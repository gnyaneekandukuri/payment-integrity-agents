        <mxCell id="maya-42" value="Gap narrows from 38% vs 18% to 38% vs 24% with alternative peers" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
