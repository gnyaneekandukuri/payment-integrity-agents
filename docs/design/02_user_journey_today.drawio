        <mxCell id="ov-12" parent="1" style="whiteSpace=wrap;html=1;rounded=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=6;fillColor=#F4F6F9;strokeColor=#888888;" value="&lt;b&gt;Routine selection (independent of any hospital review)&lt;/b&gt;&lt;br&gt;Pre-pay rules, post-pay audits, QA samples, appeal re-reviews, providers on approved prepayment review" vertex="1">
          <mxGeometry height="110" width="270" x="950" y="350" as="geometry" />
