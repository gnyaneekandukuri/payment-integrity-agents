        <mxCell id="maya-50" value="• Additional records&lt;br&gt;• Appeal outcomes over months" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
