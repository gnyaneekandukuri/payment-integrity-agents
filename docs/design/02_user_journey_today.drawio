        <mxCell id="sam-49" value="Rationale, citations, validated DRG" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="2110" y="434" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sam-50" value="Original findings + hospital&#39;s response" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="2326" y="434" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sam-51" value="&lt;b&gt;Time (typical, assumed)&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#DDE3EC;strokeColor=#B0B7C3;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="140" height="55" as="geometry" />
