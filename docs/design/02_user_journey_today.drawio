        <mxCell id="sam-54" value="10–30 min" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFF6D6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="598" y="560" width="210" height="55" as="geometry" />
