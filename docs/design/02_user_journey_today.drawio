          <mxGeometry x="20" y="621" width="140" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sam-64" value="• Queue often ordered by date, not risk&lt;br&gt;• Pre-pay claims have payment deadlines" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="166" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sam-65" value="• Code-heavy screens&lt;br&gt;• Rebuilds the &#39;why&#39; every time" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="382" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sam-66" value="• Terms buried in PDFs&lt;br&gt;• Silent contracts invite disputes" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="598" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sam-67" value="Partial records; deadlines run while waiting" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="814" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sam-68" value="No search on scanned pages" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="1030" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sam-69" value="• Values scattered&lt;br&gt;• Easy to miss one reading&lt;br&gt;• Baselines often unsourced" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="1246" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sam-70" value="• Missing baselines make it ambiguous&lt;br&gt;• Reviewers can differ" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="1462" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sam-71" value="Physician time is scarce" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="1678" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sam-72" value="• Hand-off between clinical and coding&lt;br&gt;• Sepsis support alone doesn&#39;t validate DRG 871" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="1894" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sam-73" value="• Re-typing evidence already found&lt;br&gt;• Letter quality varies" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="2110" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sam-74" value="• Whole chart re-read&lt;br&gt;• Some findings overturned" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FDE4E1;strokeColor=#D9776C;" vertex="1" parent="1">
          <mxGeometry x="2326" y="621" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sam-75" value="&lt;b&gt;Thinking&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#DDE3EC;strokeColor=#B0B7C3;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="757" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sam-76" value="“Which of these is urgent?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="166" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sam-77" value="“What exactly drives this DRG?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="382" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sam-78" value="“Am I applying the right standard?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="598" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sam-79" value="“Is this enough to judge fairly?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="814" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sam-80" value="“Where&#39;s what matters?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1030" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sam-81" value="“Did I miss something that changes the answer?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1246" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sam-82" value="“Can I defend this from the record alone?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1462" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sam-83" value="“This needs a physician&#39;s judgment.”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1678" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sam-84" value="“What does the complete coding support?”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1894" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sam-85" value="“This will be read closely on appeal.”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="2110" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sam-86" value="“I&#39;ll be reading this chart again.”" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EEE8F7;strokeColor=#9A86C2;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="2326" y="757" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sam-87" value="&lt;b&gt;Summary:&lt;/b&gt; Most of Sam&#39;s time goes into finding, organizing and re-documenting evidence, not judging it. Moments that matter: a usable record (4), complete evidence including contradictions and gaps (6), an honest &#39;cannot determine&#39; (7), and the separate coding step (9)." style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E8F3EA;strokeColor=#6AA57A;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="853" width="2522" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
