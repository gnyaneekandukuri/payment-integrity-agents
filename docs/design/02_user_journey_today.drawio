  <diagram id="ov" name="1 · Current process">
    <mxGraphModel dx="2490" dy="994" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ov-1" parent="1" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" value="&lt;b&gt;Current process: from a hospital billing pattern to a payment decision&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="1500" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="ov-2" parent="1" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" value="How the work runs today, without an assistant. Northstar Health Plan (Medicare Advantage) and Riverside General Hospital are fictional." vertex="1">
          <mxGeometry height="26" width="1500" x="20" y="56" as="geometry" />
        </mxCell>
        <mxCell id="ov-3" parent="1" style="whiteSpace=wrap;html=1;rounded=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=6;fillColor=#E6F2FB;strokeColor=#6C9BC7;" value="&lt;b&gt;1. Question&lt;/b&gt;&lt;br&gt;Riverside bills 38% of infection stays as DRG 871 vs peer median 18%&lt;br&gt;&lt;br&gt;&lt;i&gt;Who:&lt;/i&gt; monitoring report → Maya" vertex="1">
          <mxGeometry height="190" width="270" x="20" y="110" as="geometry" />
        </mxCell>
        <mxCell id="ov-4" parent="1" style="whiteSpace=wrap;html=1;rounded=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=6;fillColor=#E6F2FB;strokeColor=#6C9BC7;" value="&lt;b&gt;2. Analysis (Maya, analyst)&lt;/b&gt;&lt;br&gt;Data quality, fair peers, alternative explanations&lt;br&gt;Each: supported / weakened / unresolved&lt;br&gt;&lt;br&gt;&lt;i&gt;Evidence:&lt;/i&gt; Northstar claims, provider relations" vertex="1">
          <mxGeometry height="190" width="270" x="330" y="110" as="geometry" />
        </mxCell>
        <mxCell id="ov-5" parent="1" style="whiteSpace=wrap;html=1;rounded=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=6;fillColor=#FFF6D6;strokeColor=#D6B656;" value="&lt;b&gt;3. Records, if justified&lt;/b&gt;&lt;br&gt;Unresolved questions → targeted request for 20 stays (manager approves)&lt;br&gt;&lt;br&gt;&lt;i&gt;Not&lt;/i&gt; a statistical sample; can&#39;t be extrapolated" vertex="1">
          <mxGeometry height="190" width="270" x="640" y="110" as="geometry" />
        </mxCell>
        <mxCell id="ov-6" parent="1" style="whiteSpace=wrap;html=1;rounded=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=6;fillColor=#E8F3EA;strokeColor=#6AA57A;" value="&lt;b&gt;4. Clinical + coding review&lt;/b&gt;&lt;br&gt;Sam: does the record demonstrate the criteria?&lt;br&gt;Lena: complete coding, regroup&lt;br&gt;Dr. Adeyemi: escalations&lt;br&gt;&lt;br&gt;&lt;i&gt;Findings:&lt;/i&gt; 4 / 10 / 5 / 1 (these stays only)" vertex="1">
          <mxGeometry height="190" width="270" x="950" y="110" as="geometry" />
        </mxCell>
        <mxCell id="ov-7" parent="1" style="whiteSpace=wrap;html=1;rounded=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=6;fillColor=#EEE8F7;strokeColor=#9A86C2;" value="&lt;b&gt;5. Authorized decision&lt;/b&gt;&lt;br&gt;Manager, compliance/legal, provider relations decide what happens next" vertex="1">
          <mxGeometry height="190" width="270" x="1260" y="110" as="geometry" />
        </mxCell>
        <mxCell id="ov-8" edge="1" parent="1" source="ov-3" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2E5C8A;fontSize=12;" target="ov-4" value="">
