        <mxCell id="maya-45" value="• Rationale: unresolved questions need records&lt;br&gt;• Targeted sample: cannot be extrapolated" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
