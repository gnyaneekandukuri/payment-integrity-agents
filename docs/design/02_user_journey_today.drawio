        </mxCell>
        <mxCell id="maya-43" value="• Transfers: supported in part&lt;br&gt;• Severity: unresolved (mixed signals)&lt;br&gt;• Documentation change (new CDI program): unresolved&lt;br&gt;• Contract sepsis criteria: open question" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="814" y="434" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="maya-44" value="• Range $0 to ~$504k under stated assumptions&lt;br&gt;• Not an overpayment estimate" style="whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E6F2FB;strokeColor=#6C9BC7;" vertex="1" parent="1">
          <mxGeometry x="1030" y="434" width="210" height="120" as="geometry" />
