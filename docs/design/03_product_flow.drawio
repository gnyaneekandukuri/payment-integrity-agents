<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" type="device"><diagram id="pov" name="1 · Overview"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pov-1" value="&lt;b&gt;Product flow overview: from a monitoring lead to a clinical decision&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1560" height="34" as="geometry"/></mxCell><mxCell id="pov-2" value="As built. Fixed rules detect and calculate; the assistant prepares evidence and drafts; people decide; authorized people approve. All data fictional." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1560" height="26" as="geometry"/></mxCell><mxCell id="pov-3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="pov-4" value="Person decides or acts" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="pov-5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="285" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="pov-6" value="Assistant (AI) prepares, never decides" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="325" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="pov-7" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C27C2C;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="550" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="pov-8" value="Fixed rules / calculation (no AI)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="pov-9" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="815" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="pov-10" value="Decision point" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="855" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="pov-11" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE8F7;strokeColor=#7A63A8;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="pov-12" value="Approval by authorized people" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="pov-13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1345" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="pov-14" value="Outcome / hand-off" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1385" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="pov-15" value="&lt;b&gt;Monitoring job&lt;/b&gt;&lt;br&gt;Rules + peer profiling + change detection over all claims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C27C2C;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="220" height="110" as="geometry"/></mxCell><mxCell id="pov-16" value="&lt;b&gt;Leads list (Maya)&lt;/b&gt;&lt;br&gt;9 leads; triage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="160" width="190" height="110" as="geometry"/></mxCell><mxCell id="pov-17" value="&lt;b&gt;Lead investigation&lt;/b&gt;&lt;br&gt;Pattern agent tests 6 explanations; Maya confirms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="160" width="220" height="110" as="geometry"/></mxCell><mxCell id="pov-18" value="&lt;b&gt;Approve sample&lt;/b&gt;&lt;br&gt;20 stays" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE8F7;strokeColor=#7A63A8;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="890" y="160" width="160" height="110" as="geometry"/></mxCell><mxCell id="pov-19" value="&lt;b&gt;Sam's queue&lt;/b&gt;&lt;br&gt;Each item with its review reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="160" width="220" height="110" as="geometry"/></mxCell><mxCell id="pov-20" value="&lt;b&gt;Claim review&lt;/b&gt;&lt;br&gt;Upload records → agent builds evidence board → plain-language draft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1420" y="160" width="240" height="110" as="geometry"/></mxCell><mxCell id="pov-21" value="&lt;b&gt;Routine selection&lt;/b&gt;&lt;br&gt;Pre-payment rules, data-mining rules, QA, appeals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1085" y="360" width="200" height="90" as="geometry"/></mxCell><mxCell id="pov-22" value="&lt;b&gt;Sam decides&lt;/b&gt;&lt;br&gt;Accept / change / escalate / send to coder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1420" y="360" width="240" height="90" as="geometry"/></mxCell><mxCell id="pov-23" value="&lt;b&gt;Records follow-up&lt;/b&gt;&lt;br&gt;If unable to determine: agent drafts a targeted request; Sam approves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1420" y="520" width="240" height="100" as="geometry"/></mxCell><mxCell id="pov-24" value="&lt;b&gt;Close lead&lt;/b&gt;&lt;br&gt;Explained by the evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="580" y="360" width="220" height="80" as="geometry"/></mxCell><mxCell id="pov-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pov-15" target="pov-16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pov-26" value="open" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pov-16" target="pov-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pov-27" value="unresolved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pov-17" target="pov-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pov-28" value="release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pov-18" target="pov-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pov-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pov-19" target="pov-20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pov-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pov-20" target="pov-22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pov-31" value="unable to determine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pov-22" target="pov-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pov-32" value="also feeds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="pov-21" target="pov-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pov-33" value="explained" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="pov-17" target="pov-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pov-34" value="records arrive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;entryX=0.85;entryY=1;" edge="1" parent="1" source="pov-23" target="pov-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pov-35" value="&lt;b&gt;What changed vs today:&lt;/b&gt; monitoring finds patterns nobody named (profiling, change detection), the assistants do the assembling (explanations, evidence, gaps, requests) with every number from fixed calculations and every quote checked, so Maya and Sam spend their time judging. &lt;b&gt;What doesn't change:&lt;/b&gt; people make every clinical, coding and payment decision; approvals stay with authorized roles; missing evidence stays missing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE4E1;strokeColor=#D9776C;fontSize=13;align=left;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1640" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pmaya" name="2 · Maya – leads and investigation"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pmaya-1" value="&lt;b&gt;Product flow: leads and lead investigation (Maya Chen, payment integrity analyst)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="2930" height="34" as="geometry"/></mxCell><mxCell id="pmaya-2" value="As built. From the monitoring job's leads list to a targeted records review released to Sam." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="2930" height="26" as="geometry"/></mxCell><mxCell id="pmaya-3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="pmaya-4" value="Person decides or acts" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="pmaya-5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="285" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="pmaya-6" value="Assistant (AI) prepares, never decides" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="325" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="pmaya-7" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C27C2C;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="550" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="pmaya-8" value="Fixed rules / calculation (no AI)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="pmaya-9" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="815" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="pmaya-10" value="Decision point" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="855" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="pmaya-11" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE8F7;strokeColor=#7A63A8;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="pmaya-12" value="Approval by authorized people" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="pmaya-13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1345" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="pmaya-14" value="Outcome / hand-off" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1385" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="pmaya-15" value="" style="rounded=0;html=1;fillColor=#FAFBFD;strokeColor=#C9CED6;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="2930" height="190" as="geometry"/></mxCell><mxCell id="pmaya-16" value="&lt;b&gt;Monitoring&lt;br&gt;(scheduled job)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE3EC;strokeColor=#C9CED6;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="150" height="190" as="geometry"/></mxCell><mxCell id="pmaya-17" value="" style="rounded=0;html=1;fillColor=#F2F4F8;strokeColor=#C9CED6;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="2930" height="190" as="geometry"/></mxCell><mxCell id="pmaya-18" value="&lt;b&gt;Maya&lt;br&gt;(payment integrity analyst)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE3EC;strokeColor=#C9CED6;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="150" height="190" as="geometry"/></mxCell><mxCell id="pmaya-19" value="" style="rounded=0;html=1;fillColor=#FAFBFD;strokeColor=#C9CED6;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="2930" height="190" as="geometry"/></mxCell><mxCell id="pmaya-20" value="&lt;b&gt;Assistant&lt;br&gt;(pattern review agent)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE3EC;strokeColor=#C9CED6;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="150" height="190" as="geometry"/></mxCell><mxCell id="pmaya-21" value="" style="rounded=0;html=1;fillColor=#F2F4F8;strokeColor=#C9CED6;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="2930" height="190" as="geometry"/></mxCell><mxCell id="pmaya-22" value="&lt;b&gt;Manager, provider&lt;br&gt;relations&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE3EC;strokeColor=#C9CED6;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="150" height="190" as="geometry"/></mxCell><mxCell id="pmaya-23" value="&lt;b&gt;Detection job&lt;/b&gt;&lt;br&gt;Rules + peer profiling (every hospital, every DRG family) + change detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C27C2C;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="185.0" y="165.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="pmaya-24" value="&lt;b&gt;Leads list&lt;/b&gt;&lt;br&gt;9 leads, ranked by how many methods agree; single-method leads labelled likely noise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C27C2C;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="415.0" y="165.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="pmaya-25" value="&lt;b&gt;Triage leads&lt;/b&gt;&lt;br&gt;Opens Riverside DRG 871 (rule + profiling + change since 2024 Q3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="645.0" y="355.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="pmaya-26" value="&lt;b&gt;Question card&lt;/b&gt;&lt;br&gt;38% vs 18% community / 24% referral; quarterly trend; what it shows / doesn't show" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C27C2C;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="875.0" y="165.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="pmaya-27" value="&lt;b&gt;Test explanations&lt;/b&gt;&lt;br&gt;Reads cited metrics + provider notes; six explanations: supported / in part / weakened / unresolved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1105.0" y="545.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="pmaya-28" value="&lt;b&gt;Confirm or change&lt;/b&gt;&lt;br&gt;Each status; a change needs a reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1335.0" y="355.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="pmaya-29" value="Pattern explained?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="1580.0" y="350.0" width="170" height="130" as="geometry"/></mxCell><mxCell id="pmaya-30" value="&lt;b&gt;Close lead&lt;/b&gt;&lt;br&gt;Documented; keep monitoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="2025.0" y="355.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="pmaya-31" value="&lt;b&gt;Draft rationale&lt;/b&gt;&lt;br&gt;What records can answer; must say 'not extrapolable'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1795.0" y="545.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="pmaya-32" value="&lt;b&gt;Sensitivity + sample&lt;/b&gt;&lt;br&gt;Hypothetical $0-504k (labelled); 20 of 104 stays: short, no ICU, not transferred, home" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C27C2C;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="2255.0" y="165.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="pmaya-33" value="&lt;b&gt;Approve targeted review&lt;/b&gt;&lt;br&gt;Manager approves; provider relations informed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE8F7;strokeColor=#7A63A8;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="2485.0" y="735.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="pmaya-34" value="&lt;b&gt;Released to Sam&lt;/b&gt;&lt;br&gt;20 stays enter the clinical review queue (Lee, Patel, Nguyen + 17 awaiting records)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="2715.0" y="735.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="pmaya-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pmaya-23" target="pmaya-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pmaya-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pmaya-24" target="pmaya-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pmaya-37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pmaya-25" target="pmaya-26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pmaya-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pmaya-26" target="pmaya-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pmaya-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pmaya-27" target="pmaya-28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pmaya-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pmaya-28" target="pmaya-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pmaya-41" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pmaya-29" target="pmaya-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pmaya-42" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="pmaya-29" target="pmaya-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pmaya-43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pmaya-31" target="pmaya-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pmaya-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pmaya-32" target="pmaya-33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pmaya-45" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pmaya-33" target="pmaya-34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pmaya-46" value="&lt;b&gt;Rules in this flow:&lt;/b&gt; a lead is a question, not a finding • numbers come from fixed calculations the agent must cite • statuses are supported / in part / weakened / unresolved, never 'ruled out' • the money table is hypothetical • a targeted sample describes only the stays reviewed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE4E1;strokeColor=#D9776C;fontSize=13;align=left;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="910" width="2930" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="psam" name="3 · Sam – claim review"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="psam-1" value="&lt;b&gt;Product flow: claim clinical review (Sam Okoro, clinical reviewer)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="2700" height="34" as="geometry"/></mxCell><mxCell id="psam-2" value="As built. Records upload, live review, plain-language draft, Sam's decision, records follow-up." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="2700" height="26" as="geometry"/></mxCell><mxCell id="psam-3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="psam-4" value="Person decides or acts" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="psam-5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="285" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="psam-6" value="Assistant (AI) prepares, never decides" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="325" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="psam-7" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C27C2C;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="550" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="psam-8" value="Fixed rules / calculation (no AI)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="psam-9" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="815" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="psam-10" value="Decision point" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="855" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="psam-11" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE8F7;strokeColor=#7A63A8;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="psam-12" value="Approval by authorized people" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="psam-13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1345" y="92" width="34" height="24" as="geometry"/></mxCell><mxCell id="psam-14" value="Outcome / hand-off" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1385" y="92" width="220" height="24" as="geometry"/></mxCell><mxCell id="psam-15" value="" style="rounded=0;html=1;fillColor=#FAFBFD;strokeColor=#C9CED6;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="2700" height="190" as="geometry"/></mxCell><mxCell id="psam-16" value="&lt;b&gt;Sam&lt;br&gt;(clinical reviewer)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE3EC;strokeColor=#C9CED6;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="150" height="190" as="geometry"/></mxCell><mxCell id="psam-17" value="" style="rounded=0;html=1;fillColor=#F2F4F8;strokeColor=#C9CED6;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="2700" height="190" as="geometry"/></mxCell><mxCell id="psam-18" value="&lt;b&gt;Assistant&lt;br&gt;(claim review agent)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE3EC;strokeColor=#C9CED6;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="150" height="190" as="geometry"/></mxCell><mxCell id="psam-19" value="" style="rounded=0;html=1;fillColor=#FAFBFD;strokeColor=#C9CED6;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="2700" height="190" as="geometry"/></mxCell><mxCell id="psam-20" value="&lt;b&gt;Fixed checks&lt;br&gt;(no AI)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE3EC;strokeColor=#C9CED6;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="150" height="190" as="geometry"/></mxCell><mxCell id="psam-21" value="" style="rounded=0;html=1;fillColor=#F2F4F8;strokeColor=#C9CED6;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="2700" height="190" as="geometry"/></mxCell><mxCell id="psam-22" value="&lt;b&gt;Lena (coder), Dr. Adeyemi,&lt;br&gt;manager&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE3EC;strokeColor=#C9CED6;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="150" height="190" as="geometry"/></mxCell><mxCell id="psam-23" value="&lt;b&gt;Review queue&lt;/b&gt;&lt;br&gt;Each item shows its review reason: data-mining rule, Maya's sample, pre-payment rule, QA, appeal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="185.0" y="165.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="psam-24" value="Records received?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="430.0" y="160.0" width="170" height="130" as="geometry"/></mxCell><mxCell id="psam-25" value="&lt;b&gt;Upload + read&lt;/b&gt;&lt;br&gt;PDF pages to text; sections detected; scanned pages flagged 'needs OCR'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C27C2C;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="415.0" y="545.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="psam-26" value="&lt;b&gt;Why it's here&lt;/b&gt;&lt;br&gt;Selected by, concern, your question, not your question, context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="645.0" y="165.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="psam-27" value="&lt;b&gt;Review the record&lt;/b&gt;&lt;br&gt;Live progress: reads pages, records evidence with quotes, records gaps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="875.0" y="355.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="psam-28" value="&lt;b&gt;Checks&lt;/b&gt;&lt;br&gt;Quote must be on the page; SOFA calculated from cited values; draft consistent; wording" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C27C2C;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1105.0" y="545.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="psam-29" value="&lt;b&gt;Plain-language draft&lt;/b&gt;&lt;br&gt;Supported / not supported / unable to determine + what shows, what's uncertain, what would resolve it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1335.0" y="355.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="psam-30" value="&lt;b&gt;Sam decides&lt;/b&gt;&lt;br&gt;Evidence board with highlighted quotes; accept / change (with reason) / escalate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1565.0" y="165.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="psam-31" value="Unable to determine?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=2;" vertex="1" parent="1"><mxGeometry x="1810.0" y="160.0" width="170" height="130" as="geometry"/></mxCell><mxCell id="psam-32" value="&lt;b&gt;Records follow-up&lt;/b&gt;&lt;br&gt;Targeted request from the gaps + unresolved SOFA systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1795.0" y="355.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="psam-33" value="&lt;b&gt;Approve request&lt;/b&gt;&lt;br&gt;Claim returns to 'awaiting records'; nothing sent in demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE8F7;strokeColor=#7A63A8;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="2025.0" y="165.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="psam-34" value="&lt;b&gt;Coder + approvals&lt;/b&gt;&lt;br&gt;Lena validates all codes and regroups; physician advisor for escalations; manager approves any adjustment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;arcSize=10;" vertex="1" parent="1"><mxGeometry x="2255.0" y="735.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="psam-35" value="&lt;b&gt;Appeal re-review&lt;/b&gt;&lt;br&gt;Same evidence board reopens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="2485.0" y="735.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="psam-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="psam-23" target="psam-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-37" value="no: upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="psam-24" target="psam-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="psam-25" target="psam-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-39" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="psam-24" target="psam-26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="psam-26" target="psam-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="psam-27" target="psam-28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="psam-28" target="psam-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="psam-29" target="psam-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="psam-30" target="psam-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-45" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="psam-31" target="psam-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="psam-32" target="psam-33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-47" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="psam-31" target="psam-34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-48" value="if appealed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="psam-34" target="psam-35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="psam-49" value="&lt;b&gt;Rules in this flow:&lt;/b&gt; a person reviews every case • missing evidence is shown as 'not documented', never normal • clinical review is separate from coding and DRG assignment • the assistant drafts; it never denies, regroups or sends anything" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE4E1;strokeColor=#D9776C;fontSize=13;align=left;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="910" width="2700" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>