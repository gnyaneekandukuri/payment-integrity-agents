ue="Assistant (LLM)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="436" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="comp-9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="590" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="comp-10" value="Fixed rules / calculation" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="626" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="comp-11" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#EEE8F7;strokeColor=#7A63A8;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="comp-12" value="Stored data" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="816" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="comp-13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="970" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="comp-14" value="External / offline" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1006" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="comp-15" value="Web app (React + Vite + Tailwind)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#9AA5B5;dashed=1;verticalAlign=top;align=left;spacing=10;fontSize=14;fontStyle=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="1400" height="140" as="geometry"/></mxCell><mxCell id="comp-16" value="&lt;b&gt;Maya&lt;/b&gt;&lt;br&gt;Leads list · lead investigation: question card, explanations, sensitivity, sample approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="320" height="80" as="geometry"/></mxCell><mxCell id="comp-17" value="&lt;b&gt;Sam&lt;/b&gt;&lt;br&gt;Review queue with review reasons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="200" height="80" as="geometry"/></mxCell><mxCell id="comp-18" value="&lt;b&gt;Sam&lt;/b&gt;&lt;br&gt;Upload records · live progress · evidence board · SOFA · plain-language draft · records follow-up · actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="380" height="80" as="geometry"/></mxCell><mxCell id="comp-19" value="&lt;b&gt;Evaluation&lt;/b&gt;&lt;br&gt;Script + docs/EVALUATION.md; live vs replay indicator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="170" width="400" height="80" as="geometry"/></mxCell><mxCell id="comp-20" value="&lt;b&gt;API (Python · FastAPI)&lt;/b&gt; — JSON endpoints: leads · patterns · queue · cases · records upload · reviews · runs (progress) · records requests · actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;fontSize=12;spacing=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="1400" height="50" as="geometry"/></mxCell><mxCell id="comp-21" value="calls" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp-15" target="comp-20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-22" value="&lt;b&gt;Analytics + monitoring job&lt;/b&gt;&lt;br&gt;Cited metrics, peer comparisons, sensitivity; rules + peer profiling + change detection → leads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="252" height="110" as="geometry"/></mxCell><mxCell id="comp-23" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.09;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp-20" target="comp-22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-24" value="&lt;b&gt;Chart service&lt;/b&gt;&lt;br&gt;Upload; PDF → page text (PyMuPDF); sections; scanned pages flagged; search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="307" y="420" width="252" height="110" as="geometry"/></mxCell><mxCell id="comp-25" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.295;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp-20" target="comp-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-26" value="&lt;b&gt;Review actions&lt;/b&gt;&lt;br&gt;Decisions + audit log; sample approval releases cases to Sam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="594" y="420" width="252" height="110" as="geometry"/></mxCell><mxCell id="comp-27" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp-20" target="comp-26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-28" value="&lt;b&gt;Agent runtime&lt;/b&gt;&lt;br&gt;Claim review + pattern review agents (loops); records-request writer (one call); trace; saved runs. &lt;i&gt;Tab 2.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="881" y="420" width="252" height="110" as="geometry"/></mxCell><mxCell id="comp-29" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.705;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp-20" target="comp-28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-30" value="&lt;b&gt;Evaluation + demo tools&lt;/b&gt;&lt;br&gt;tools.evaluate (facts vs answer keys); demo_reset; export_preview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1168" y="420" width="252" height="110" as="geometry"/></mxCell><mxCell id="comp-31" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.91;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp-20" target="comp-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-32" value="&lt;b&gt;Validators (fixed)&lt;/b&gt;&lt;br&gt;Citation · SOFA calculator · consistency · wording" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="881" y="590" width="252" height="90" as="geometry"/></mxCell><mxCell id="comp-33" value="&lt;b&gt;LLM provider&lt;/b&gt;&lt;br&gt;OpenAI (live) or replay (saved runs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1168" y="590" width="252" height="90" as="geometry"/></mxCell><mxCell id="comp-34" value="every write" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp-28" target="comp-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-35" value="model calls" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="comp-28" target="comp-33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-36" value="&lt;b&gt;Storage: SQLite + files&lt;/b&gt;&lt;br&gt;claims · hospitals · contracts · notes · leads · questions · explanations · samples · cases · evidence · gaps · SOFA · drafts · records requests · actions · runs · chart PDFs · uploads · saved runs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#EEE8F7;strokeColor=#7A63A8;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="813" height="90" as="geometry"/></mxCell><mxCell id="comp-37" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.155;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp-22" target="comp-36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-38" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.508;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp-24" target="comp-36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-39" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.861;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp-26" target="comp-36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-40" value="accepted writes only" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="comp-32" target="comp-36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-41" value="&lt;b&gt;OpenAI API&lt;/b&gt;&lt;br&gt;Key in local .env, never committed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1168" y="740" width="252" height="90" as="geometry"/></mxCell><mxCell id="comp-42" value="live only" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp-33" target="comp-41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-43" value="&lt;b&gt;Offline data generators&lt;/b&gt;&lt;br&gt;Fictional claims (calibrated + extra lead patterns), case files → chart PDFs, upload records, answer keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="870" width="813" height="60" as="geometry"/></mxCell><mxCell id="comp-44" value="seed" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="comp-43" target="comp-36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="comp-45" value="&lt;b&gt;Trust boundaries:&lt;/b&gt; the LLM never writes to storage directly — every write passes a validator • there is no tool for regrouping, pricing, denying or sending • numbers come from the analytics service and the SOFA calculator, never from the model • replay mode runs the demo without the network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE4E1;strokeColor=#D9776C;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="1400" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="agent" name="2 · Agents and tools"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="agent-1" value="&lt;b&gt;System design: the agents and their tools&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1500" height="34" as="geometry"/></mxCell><mxCell id="agent-2" value="Agentic, not a fixed pipeline: the model decides which tool to call next, looks at the result, and repeats until it submits a draft. Fixed code checks every write." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1500" height="26" as="geometry"/></mxCell><mxCell id="agent-3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="agent-4" value="Screen" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="agent-5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="210" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="agent-6" value="Service" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="246" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="agent-7" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="agent-8" value="Assistant (LLM)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="436" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="agent-9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="590" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="agent-10" value="Fixed rules / calculation" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="626" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="agent-11" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#EEE8F7;strokeColor=#7A63A8;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="agent-12" value="Stored data" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="816" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="agent-13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="970" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="agent-14" value="External / offline" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1006" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="agent-15" value="Claim review agent (Sam's flow)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#9AA5B5;dashed=1;verticalAlign=top;align=left;spacing=10;fontSize=14;fontStyle=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="1500" height="560" as="geometry"/></mxCell><mxCell id="agent-16" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;• Claim ID&lt;br&gt;• Goal: prepare evidence for the selected criteria&lt;br&gt;• Rules (system prompt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="220" height="130" as="geometry"/></mxCell><mxCell id="agent-17" value="&lt;b&gt;Agent loop (bounded)&lt;/b&gt;&lt;br&gt;1. Model reads goal + history&lt;br&gt;2. Picks a tool and arguments&lt;br&gt;3. Runtime runs the tool&lt;br&gt;4. Result (or rejection) goes back to the model&lt;br&gt;5. Repeat — max 60 steps&lt;br&gt;6. Ends only via &lt;i&gt;submit_draft&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="310" y="180" width="300" height="170" as="geometry"/></mxCell><mxCell id="agent-18" value="&lt;b&gt;LLM (OpenAI)&lt;/b&gt;&lt;br&gt;or replay of a saved run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="360" y="400" width="200" height="70" as="geometry"/></mxCell><mxCell id="agent-19" value="&lt;b&gt;Trace&lt;/b&gt;&lt;br&gt;Every step: tool, arguments, result, accepted / rejected, tokens" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#EEE8F7;strokeColor=#7A63A8;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="240" height="80" as="geometry"/></mxCell><mxCell id="agent-20" value="asks next step" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent-17" target="agent-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agent-21" value="logs" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="agent-17" target="agent-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agent-22" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent-16" target="agent-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agent-23" value="&lt;b&gt;Read tools&lt;/b&gt;&lt;br&gt;get_claim — codes, DRG, POA&lt;br&gt;get_contract_criteria — Sepsis-3 or 'silent'&lt;br&gt;list_pages — sections of the chart&lt;br&gt;search_chart — keyword search&lt;br&gt;read_page — full page text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="680" y="170" width="300" height="150" as="geometry"/></mxCell><mxCell id="agent-24" value="&lt;b&gt;Calculate tool (fixed)&lt;/b&gt;&lt;br&gt;compute_sofa — scores each system from &lt;i&gt;cited&lt;/i&gt; values only; missing = 'not documented'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="680" y="345" width="300" height="90" as="geometry"/></mxCell><mxCell id="agent-25" value="&lt;b&gt;Write tools&lt;/b&gt;&lt;br&gt;record_evidence — value, time, page, quote, supports / contradicts&lt;br&gt;record_gap — missing or conflicting, why it matters&lt;br&gt;submit_draft — conclusion + plain-language parts + evidence IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="680" y="460" width="300" height="120" as="geometry"/></mxCell><mxCell id="agent-26" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="agent-17" target="agent-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agent-27" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="agent-17" target="agent-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agent-28" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="agent-17" target="agent-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agent-29" value="&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;Claims data, contracts, chart page text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="195" width="220" height="100" as="geometry"/></mxCell><mxCell id="agent-30" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent-23" target="agent-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agent-31" value="&lt;b&gt;Validators (fixed)&lt;/b&gt;&lt;br&gt;• Citation: quote must be on that page&lt;br&gt;• Consistency: draft must match the evidence&lt;br&gt;• Wording: no 'overpayment' / 'fraud'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="1040" y="450" width="260" height="140" as="geometry"/></mxCell><mxCell id="agent-32" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent-25" target="agent-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agent-33" value="&lt;b&gt;Storage&lt;/b&gt;&lt;br&gt;Accepted evidence, gaps, SOFA, draft" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#EEE8F7;strokeColor=#7A63A8;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1340" y="455" width="160" height="130" as="geometry"/></mxCell><mxCell id="agent-34" value="accepted" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent-31" target="agent-33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="agent-35" value="Rejected → returned to the agent as feedback; it must fix or downgrade to 'cannot determine'" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#9C3D2E;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1040" y="610" width="460" height="50" as="geometry"/></mxCell><mxCell id="agent-36" value="&lt;b&gt;Output to Sam&lt;/b&gt;&lt;br&gt;Evidence board, gaps, SOFA table, draft conclusion. Sam decides." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1300" y="195" width="200" height="100" as="geometry"/></mxCell><mxCell id="agent-37" value="&lt;b&gt;Records-request writer&lt;/b&gt;&lt;br&gt;One structured call, not a loop: turns gaps + unresolved SOFA systems into a targeted request; wording and page checks; template fallback; Sam approves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="240" height="150" as="geometry"/></mxCell><mxCell id="agent-38" value="Pattern review agent (Maya's flow) — smaller, same pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#9AA5B5;dashed=1;verticalAlign=top;align=left;spacing=10;fontSize=14;fontStyle=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="1500" height="200" as="geometry"/></mxCell><mxCell id="agent-39" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;A lead from the monitoring job (Riverside, DRG 871) + six explanations to test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="230" height="110" as="geometry"/></mxCell><mxCell id="agent-40" value="&lt;b&gt;Agent loop&lt;/b&gt;&lt;br&gt;For each explanation, decides which metrics and notes to check, then proposes a status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="310" y="770" width="300" height="110" as="geometry"/></mxCell><mxCell id="agent-41" value="&lt;b&gt;Tools&lt;/b&gt;&lt;br&gt;list_metrics / get_metric (fixed calc, with fixed comparison sentences)&lt;br&gt;get_notes — provider relations, contract&lt;br&gt;record_explanation — supported / in part / weakened / unresolved + citations&lt;br&gt;draft_sample_rationale — must say 'not extrapolable'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="680" y="760" width="420" height="130" as="geometry"/></mxCell><mxCell id="agent-42" value="&lt;b&gt;Validators&lt;/b&gt;&lt;br&gt;Allowed statuses only · every claim cites a metric or note · wording" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="1140" y="770" width="200" height="110" as="geometry"/></mxCell><mxCell id="agent-43" value="&lt;b&gt;Output to Maya&lt;/b&gt;&lt;br&gt;Explanation tracker; Maya confirms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1370" y="770" width="130" height="110" as="geometry"/></mxCell><mxCell id="agent-44" value="&lt;b&gt;Guardrails built into the tool set:&lt;/b&gt; there is no tool to regroup a DRG, price, deny, approve, send a letter or contact a hospital — so the agents cannot do those things • the model never writes to storage directly • numbers come from fixed tools • a step limit stops runaway loops • every run is saved and can be replayed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE4E1;strokeColor=#D9776C;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="940" width="1500" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="seq" name="3 · Claim review sequence"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seq-1" value="&lt;b&gt;System design: one claim review, step by step&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="seq-2" value="What happens when Sam opens a claim (e.g. Mr. Patel). Green = assistant; yellow = fixed check; blue = Sam / screen; white = API." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1000" height="26" as="geometry"/></mxCell><mxCell id="seq-3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="seq-4" value="Screen" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="seq-5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="210" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="seq-6" value="Service" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="246" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="seq-7" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="seq-8" value="Assistant (LLM)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="436" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="seq-9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="590" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="seq-10" value="Fixed rules / calculation" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="626" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="seq-11" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#EEE8F7;strokeColor=#7A63A8;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="seq-12" value="Stored data" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="816" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="seq-13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#888888;fontSize=12;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="970" y="92" width="30" height="22" as="geometry"/></mxCell><mxCell id="seq-14" value="External / offline" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1006" y="92" width="150" height="22" as="geometry"/></mxCell><mxCell id="seq-15" value="1. Records arrive: Sam uploads the PDF → pages extracted, sections detected, scanned pages flagged → Sam starts the review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="140" width="820" height="60" as="geometry"/></mxCell><mxCell id="seq-16" value="2. Runtime starts the claim review assistant; the trace begins (live or replay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="225" width="820" height="60" as="geometry"/></mxCell><mxCell id="seq-17" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-15" target="seq-16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="seq-18" value="3. get_claim, get_contract_criteria → what drives DRG 871; flags 'contract silent' if so" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="310" width="820" height="60" as="geometry"/></mxCell><mxCell id="seq-19" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-16" target="seq-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="seq-20" value="4. list_pages, search_chart, read_page → completeness check against the criteria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="395" width="820" height="60" as="geometry"/></mxCell><mxCell id="seq-21" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-18" target="seq-20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="seq-22" value="5. record_evidence → citation validator: the quote must exist on that page, or it's rejected (and traced)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="480" width="820" height="60" as="geometry"/></mxCell><mxCell id="seq-23" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-20" target="seq-22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="seq-24" value="6. record_gap → missing or conflicting items (e.g. unsourced baseline creatinine; conflicting mental-status notes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="565" width="820" height="60" as="geometry"/></mxCell><mxCell id="seq-25" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-22" target="seq-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="seq-26" value="7. compute_sofa → per-system baseline, worst, change; components with no cited value = 'not documented'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="650" width="820" height="60" as="geometry"/></mxCell><mxCell id="seq-27" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-24" target="seq-26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="seq-28" value="8. submit_draft → conclusion + plain-language parts (summary, what shows, uncertain, would resolve) + evidence IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#4E8F5E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="735" width="820" height="60" as="geometry"/></mxCell><mxCell id="seq-29" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-26" target="seq-28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="seq-30" value="9. Consistency + wording validators → if inconsistent, the assistant revises or downgrades to 'cannot determine'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B8962E;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="820" width="820" height="60" as="geometry"/></mxCell><mxCell id="seq-31" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-28" target="seq-30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="seq-32" value="10. Workspace: why it is here · evidence board with highlighted quotes · gaps · SOFA · plain-language draft · steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8F7;strokeColor=#2E5C8A;fontSize=12;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="905" width="820" height="60" as="geometry"/></mxCell><mxCell id="seq-33" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#44546A;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq-30" target="seq-32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="seq-34" value="11. Sam accepts / edits / changes / escalates → every action goes to the audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC